# /etc/bureau/bureau.env — read by bureau@<user>.service
#
# Bind address. 127.0.0.1:8787 = this machine only.
# 0.0.0.0:8787 = reachable from your LAN (recommended only together with a token).
BUREAU_BIND=0.0.0.0:8787

# Require this token for every /api call. Leave empty to disable auth.
# Generate one with: openssl rand -hex 24
# Open the board once with http://<host>:8787/?token=<token> — the browser keeps it.
#BUREAU_TOKEN=

# Optional: where seed divisions look for projects.
#BUREAU_PROJECTS_ROOT=/home/you/Projects
